<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-clause</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>titanium-clause-web</artifactId>
    <name>titanium-clause-web</name>
    <description>Web layer for Titanium Insurance Clause Service</description>

    <dependencies>
        <!-- API Module -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-clause-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Application Module -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-clause-application</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Query Module（读入口 VO 组装依赖 ClauseQueryResult 读侧契约） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-clause-query</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Common Module（TenantContext 多租户上下文） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-clause-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MapStruct（Request/DTO ⇄ 读模型结果 结构翻译） -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- 禁用Spring Boot Maven Plugin的repackage目标，因为这是一个领域层模块，不需要主类 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <!-- MapStruct + Lombok 注解处理器 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>