<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-clause</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>titanium-clause-domain</artifactId>
    <name>titanium-clause-domain</name>
    <description>Domain layer for Titanium Insurance Clause Service</description>

    <dependencies>
        <!-- Common Module -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-clause-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 通用内核(聚合根基类BaseAggregate) -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-kernel</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Axon Framework -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-messaging</artifactId>
        </dependency>
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-modelling</artifactId>
        </dependency>
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-spring</artifactId>
        </dependency>

        <!-- Spring 上下文（仅 @Component 领域服务注解；PKG-01：domain 不引入 Boot） -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- 测试 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 聚合根 @EventSourcingHandler 依赖（m27-01：analyze 报 used-undeclared，显式声明） -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-eventsourcing</artifactId>
        </dependency>
        <!-- 共享枚举/错误码（entity/valueobject 生产面直接使用；m27-01 起显式声明） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-metadata</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
    
        <!-- Jackson 注解（值对象/事件 @JsonIgnore 等；m27-01：原经 titanium-common 传递获得，现显式声明） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
    
        <!-- 测试面 assertThat/Matcher（m27-01：原经 junit 聚合构件传递获得） -->
        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- m27-01/PKG-01：领域层 classpath 纯净门禁（规则见 titanium-parent pluginManagement） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <!-- 禁用Spring Boot Maven Plugin的repackage目标，因为这是一个领域层模块，不需要主类 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>