<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-clause</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>titanium-clause-bootstrap</artifactId>
    <name>titanium-clause-bootstrap</name>
    <description>Bootstrap module for Titanium Insurance Clause Service</description>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Web Module -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-clause-web</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Infrastructure Module -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-clause-infrastructure</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- CQRS 读侧（组合根装配读模型投影/查询/DLQ） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-clause-query</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ============ 架构守护测试（仅 test 作用域，不进运行时） ============ -->
        <!-- 共享 ArchUnit 基类制品：提供 AbstractArchitectureGuardTest -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-build-tools</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit：以 JUnit 测试形式校验 CLAUDE.md 的分层/命名/依赖约束（版本由 parent 管理） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot Test：提供 JUnit5 运行环境 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Liquibase：数据库版本管理 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <configuration>
                <mainClass>com.titanium.clause.ClauseApplication</mainClass>
            </configuration>
            <executions>
                <execution>
                    <goals>
                        <goal>repackage</goal>
                    </goals>
                </execution>
            </executions>
        </plugin>
        </plugins>
    </build>
</project>